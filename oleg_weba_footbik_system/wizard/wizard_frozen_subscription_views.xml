<odoo>

    <record id="wizard_frozen_subscription_form" model="ir.ui.view">
        <field name="name">wizard.frozen.subscription.form</field>
        <field name="model">wizard.frozen.subscription</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="sale_subscription_id" invisible="1"/>

                        <field name="start_frozen_date" required="1"/>
                        <field name="end_frozen_date" required="1"/>
                    </group>
                    <group>
                        <field name="reason_frozen" required="1"/>
                    </group>
                </group>

                <footer>
                    <div style="margin-left: 425px;">
                        <div style="margin-right: 5px; display: inline-block;">
                            <button name="action_create" string="Create" type="object" class="btn-success"/>
                        </div>
                        <div style="display: inline-block;">
                            <button special="cancel" class="btn-danger" string="Close"/>
                        </div>
                    </div>
                </footer>
            </form>
        </field>
    </record>

</odoo>
