<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="category_oleg_weba_footbik_system" model="ir.module.category">
            <field name="name">oleg_weba_footbik_system</field>
            <field name="description">User access levels for oleg_weba_footbik_system</field>
            <field name="sequence">1</field>
        </record>

        <record id="access_change_state_on_active" model="res.groups">
            <field name="name">Access change state on active in sale.subscription</field>
            <field name="category_id" ref="category_oleg_weba_footbik_system"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="add_delete_child_from_sub" model="res.groups">
            <field name="name">Access to add or delete child in subscription from group and training</field>
            <field name="category_id" ref="category_oleg_weba_footbik_system"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>


        <!--Rewrite access to sale.subscription from module subscription_oca-->
        <record id="subscription_oca.access_custom_sale_subscription" model="ir.model.access">
            <field name="perm_unlink">0</field>
        </record>

        <!--Close access to sale.subscription.stage on create,write,unlink-->
        <record id="subscription_oca.access_custom_sale_subscription_stage" model="ir.model.access">
            <field name="perm_create">0</field>
            <field name="perm_write">0</field>
            <field name="perm_unlink">0</field>
        </record>
        <record id="crud_sale_subscription_stage_for_admin" model="res.groups">
            <field name="name">Access to full CRUD in sale.subscription.stage for Admin</field>
            <field name="category_id" ref="category_oleg_weba_footbik_system"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>