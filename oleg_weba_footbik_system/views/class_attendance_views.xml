<odoo>

    <record id="class_attendance_view_tree_inherit" model="ir.ui.view">
        <field name="name">class.attendance.view.tree.inherit</field>
        <field name="model">class.attendance</field>
        <field name="inherit_id" ref="oleg_weba_footbik.class_attendance_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="age"/>
            </xpath>
            <xpath expr="//field[@name='comment']" position="after">
                <field name="sum_pay"/>
                <field name="date_pay"/>
            </xpath>

            <xpath expr="//field[@name='subscription_frozen']" position="after">
                <field name="promoter_id" widget="many2one_avatar_user" optional="show"/>
                <field name="manager_id" widget="many2one_avatar_employee" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="class_attendance_view_form_inherit" model="ir.ui.view">
        <field name="name">class.attendance.view.form.inherit</field>
        <field name="model">class.attendance</field>
        <field name="inherit_id" ref="oleg_weba_footbik.class_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="age"/>
            </xpath>
            <xpath expr="//field[@name='comment']" position="after">
                <field name="sum_pay"/>
                <field name="date_pay"/>
            </xpath>

            <xpath expr="//field[@name='qualification']" position="after">
                <field name="opportunity_id" invisible="1"/>
                <field name="promoter_id" widget="many2one_avatar_user"/>
                <field name="manager_id" widget="many2one_avatar_employee"/>
            </xpath>
        </field>
    </record>

</odoo>
