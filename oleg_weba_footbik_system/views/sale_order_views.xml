<odoo>

    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">view.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_agreement"/>

                <field name="can_write" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">not can_write</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">not can_write</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="date_start_subscription"/>
            </xpath>

            <xpath expr="//tree/control/create[@name='add_section_control']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>

            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//group" position="inside">
                <field name="view_group_add_intro" invisible="1"/>
                <field name="status_paid" invisible="1"/>

                <group string="Record on Qualification"
                       invisible="not partner_id or not view_group_add_intro or not status_paid">
                    <field name="program_id"/>

                    <!--1 группа-->
                    <field name="domain_training_1_id" invisible="1"/>
                    <field name="training_1_id" domain="domain_training_1_id" invisible="not program_id"/>

                    <label for="added_trial_training_1" invisible="not program_id or not training_1_id"/>
                    <div class="o_row" invisible="not program_id or not training_1_id">
                        <field name="added_trial_training_1" readonly="1" force_save="1" class="oe_inline"/>

                        <button name="action_add_child_on_trial_training_1" type="object"
                            string="Add to training" class="btn btn-success text-nowrap"
                            invisible="added_trial_training_1"/>
                    </div>
                    <!--1 группа-->

                    <!--2 группа-->
                    <field name="domain_training_2_id" invisible="1"/>
                    <field name="training_2_id" domain="domain_training_2_id" invisible="not program_id"/>

                    <label for="added_trial_training_2" invisible="not program_id or not training_2_id"/>
                    <div class="o_row" invisible="not program_id or not training_2_id">
                        <field name="added_trial_training_2" readonly="1" force_save="1" class="oe_inline"/>

                        <button name="action_add_child_on_trial_training_2" type="object"
                            string="Add to training" class="btn btn-success text-nowrap"
                            invisible="added_trial_training_2"/>
                    </div>
                    <!--2 группа-->

                </group>
            </xpath>

            <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send'][4]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_kanban_inherit" model="ir.ui.view">
        <field name="name">view.sale.order.kanban.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
