<odoo>

    <!--MENU-->
    <record id="crm.crm_lead_menu_my_activities" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="sale_crm.sale_order_menu_quotations_crm" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="crm.sales_team_menu_team_pipeline" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="crm.res_partner_menu_customer" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <record id="crm.menu_crm_opportunities" model="ir.ui.menu">
        <field name="name">Clients</field>
    </record>
    <!--MENU-->

    <record id="crm.crm_lead_all_leads" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,graph,pivot,calendar,form,activity</field>
    </record>
    <record id="crm.crm_lead_all_leads_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
    </record>
    <record id="crm.crm_lead_all_leads_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
    </record>

    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="context">{'default_type': 'opportunity'}</field>
    </record>

    <record id="view_crm_lead_kanban_inherit" model="ir.ui.view">
        <field name="name">view.crm.lead.kanban.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">stage_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_leads_inherit" model="ir.ui.view">
        <field name="name">crm.case.tree.view.leads.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='city']" position="after">
                <field name="age_store" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.case.tree.view.oppor.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='city']" position="after">
                <field name="age_store" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="invisible">not active</attribute>
            </xpath>

            <xpath expr="//button[@name='action_schedule_meeting']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//h2" position="attributes">
                <attribute name="class">row g-0 pb-3 pb-sm-4 o_hidden</attribute>
            </xpath>

            <!--Rewrite global group for swap fields-->
            <xpath expr="//group" position="replace">
                <group>

                    <group name="lead_info" invisible="type == 'opportunity'">
                        <field name="contact_name" string="Full name"/>  <!--Custom-->

                        <!--Для отступа-->
<!--                        <label for="gender" string=""/>-->
<!--                        <div style="margin-bottom: 15px;"/>-->
                        <!--Для отступа-->

                        <field name="gender"/>  <!--Custom-->

                        <field name="is_blacklisted" invisible="1"/>
                        <field name="phone_blacklisted" invisible="1"/>
                        <field name="email_state" invisible="1"/>
                        <field name="phone_state" invisible="1"/>
                        <field name="partner_email_update" invisible="1"/>
                        <field name="partner_phone_update" invisible="1"/>

                        <!--Custom-->
                        <label for="birthday"/>
                        <div class="o_row">
                            <field name="age" invisible="1"/>

                            <field name="birthday"/>
                            <span>Age:</span>
                            <field name="age_store" readonly="1"/>
                        </div>

                        <label for="city" string="City"/>
                        <div class="o_address_format">
                            <field name="street" placeholder="Street..." class="o_address_street" invisible="1"/> <!--Custom-->
                            <field name="street2" placeholder="Street 2..." class="o_address_street" invisible="1"/> <!--Custom-->
                            <field name="city" placeholder="City" class="o_address_city"/> <!--Custom-->
                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}' invisible="1"/> <!--Custom-->
                            <field name="zip" placeholder="ZIP" class="o_address_zip" invisible="1"/> <!--Custom-->
                            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/> <!--Custom-->
                        </div>
                        <!--Custom-->

                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>

                        <label for="phone_group_lead_info" class="oe_inline"/>
                        <div class="o_row o_row_readonly">
                            <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger"
                                title="This phone number is blacklisted for SMS Marketing. Click to unblacklist."
                                type="object" context="{'default_phone': phone}" groups="base.group_user"
                                invisible="not phone_blacklisted"/>
                            <field name="phone" id="phone_group_lead_info" widget="phone"/>
                            <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                                title="By saving this change, the customer phone number will also be updated."
                                invisible="not partner_phone_update"/>
                        </div>

                        <label for="email_from_group_lead_info" class="oe_inline"/>
                        <div class="o_row o_row_readonly">
                            <button name="mail_action_blacklist_remove" class="fa fa-ban text-danger"
                                title="This email is blacklisted for mass mailings. Click to unblacklist."
                                type="object" context="{'default_email': email_from}" groups="base.group_user"
                                invisible="not is_blacklisted"/>
                            <field name="email_from" id="email_from_group_lead_info" string="Email" widget="email"/>
                            <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                                title="By saving this change, the customer email will also be updated."
                                invisible="not partner_email_update"/>
                        </div>

                        <field name="lang_id" invisible="lang_active_count &lt;= 1"
                            options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>

                        <field name="email_cc" groups="base.group_no_one"/>  <!--Custom-->
                        <field name="function" groups="base.group_system"/>  <!--Custom-->

                        <label for="mobile" class="oe_inline o_hidden"/>  <!--Custom-->
                        <div class="o_row o_row_readonly" style="display: none;">  <!--Custom-->
                            <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger"
                                title="This phone number is blacklisted for SMS Marketing. Click to unblacklist."
                                type="object" context="{'default_phone': mobile}" groups="base.group_user"
                                invisible="not mobile_blacklisted"/>
                            <field name="mobile" widget="phone" string="Mobile"/>
                        </div>
                    </group>


                    <group name="opportunity_partner" string="Information about children" invisible="type == 'lead'">

                        <field name="partner_id"
                            widget="res_partner_many2one"
                            string="Customer"
                            context="{'res_partner_search_mode': type == 'opportunity' and 'customer' or False,
                                'default_name': contact_name or partner_name,
                                'default_street': street,
                                'default_is_company': type == 'opportunity' and contact_name == False,
                                'default_company_name': type == 'opportunity' and partner_name,
                                'default_street2': street2,
                                'default_city': city,
                                'default_title': title,
                                'default_state_id': state_id,
                                'default_zip': zip,
                                'default_country_id': country_id,
                                'default_function': function,
                                'default_phone': phone,
                                'default_mobile': mobile,
                                'default_email': email_from,
                                'default_user_id': user_id,
                                'default_team_id': team_id,
                                'default_website': website,
                                'default_lang': lang_code,
                                'show_vat': True,
                            }"
                        />

                        <label for="phone" class="oe_inline"/>
                        <div class="o_row o_row_readonly">
                            <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger"
                                title="This phone number is blacklisted for SMS Marketing. Click to unblacklist."
                                type="object" context="{'default_phone': phone}" groups="base.group_user"
                                invisible="not phone_blacklisted"/>
                            <field name="phone" widget="phone"/>
                            <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                                title="By saving this change, the customer phone number will also be updated."
                                invisible="not partner_phone_update"/>
                        </div>

                        <field name="gender"/>  <!--Custom-->

                        <!--Custom-->
                        <label for="birthday"/>
                        <div class="o_row">
                            <field name="age" invisible="1"/>

                            <field name="birthday"/>
                            <span>Age:</span>
                            <field name="age_store" readonly="1" force_save="1"/>
                        </div>

                        <field name="lang_id" invisible="lang_active_count &lt;= 1"
                            options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>

                        <field name="skills_id"/>
                        <field name="need_text"/>
                        <field name="features_development" widget="boolean_toggle"/>

                        <field name="lost_reason_id" invisible="active"/>

                        <label for="email_from" class="oe_inline" invisible="1"/>
                        <div class="o_row o_row_readonly" style="display: none;">
                            <button name="mail_action_blacklist_remove" class="fa fa-ban text-danger"
                                title="This email is blacklisted for mass mailings. Click to unblacklist."
                                type="object" context="{'default_email': email_from}" groups="base.group_user"
                                invisible="not is_blacklisted"/>
                            <field name="email_from" string="Email" widget="email"/>
                            <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                                title="By saving this change, the customer email will also be updated."
                                invisible="not partner_email_update"/>
                        </div>

                        <field name="is_blacklisted" invisible="1"/>
                        <field name="partner_is_blacklisted" invisible="1"/>
                        <field name="phone_blacklisted" invisible="1"/>
                        <field name="mobile_blacklisted" invisible="1"/>
                        <field name="email_state" invisible="1"/>
                        <field name="phone_state" invisible="1"/>
                        <field name="partner_email_update" invisible="1"/>
                        <field name="partner_phone_update" invisible="1"/>

                        <field name="date_conversion" invisible="1"/>
                        <field name="user_company_ids" invisible="1"/>
                    </group>


                    <group name="lead_partner" invisible="type == 'opportunity'">
                        <field name="full_name_parent"/>  <!--Custom-->
                        <field name="type_parent"/>  <!--Custom-->
                        <field name="telephone_parent"/>  <!--Custom-->
<!--                        <field name="gender_parent"/>-->  <!--Custom-->
                         <field name="email_parent" groups="base.group_system"/>  <!--Custom-->

                        <!-- Preload all the partner's information -->
                        <field name="is_partner_visible" invisible='1'/>
                        <field name="partner_id" widget="res_partner_many2one"
                            context="{
                                'default_name': contact_name,
                                'default_title': title,
                                'default_street': street,
                                'default_street2': street2,
                                'default_city': city,
                                'default_state_id': state_id,
                                'default_zip': zip,
                                'default_country_id': country_id,
                                'default_function': function,
                                'default_phone': phone,
                                'default_mobile': mobile,
                                'default_email': email_from,
                                'default_user_id': user_id,
                                'default_team_id': team_id,
                                'default_website': website,
                                'default_lang': lang_code,
                                'show_vat': True
                            }" invisible="not is_partner_visible" groups="base.group_system"/>

                        <field name="partner_name" groups="base.group_system"/>  <!--Custom-->

                        <field name="website" widget="url" placeholder="e.g. https://footbik.odoo24.online"
                               groups="base.group_system"/>  <!--Custom-->

                        <label for="street" string="Address" class="o_hidden"/>  <!--Custom-->
                        <div class="o_address_format" style="display: none;">  <!--Custom-->
                            <field name="street" placeholder="Street..." class="o_address_street"/>
                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                            <field name="city" placeholder="City" class="o_address_city"/>
                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                        </div>

                        <field name="lang_active_count" invisible="1"/>  <!--Custom-->
                        <field name="lang_code" invisible="1"/>  <!--Custom-->
                        <field name="lang_id" invisible="1"
                            options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>  <!--Custom-->
                    </group>

                    <field name="type" invisible="1"/>

                    <group invisible="type == 'lead'" string="Dad">
                        <field name="domain_parent_id" invisible="1"/>
                        <field name="parent_id" domain="domain_parent_id" widget="many2one_avatar_user"/>

                        <field name="full_name_parent" readonly="type == 'opportunity'"/>
                        <field name="type_parent" readonly="type == 'opportunity'"/>
                        <field name="telephone_parent" readonly="type == 'opportunity'"/>

<!--                        <field name="gender_parent" invisible="1" readonly="type == 'opportunity'"/>-->
<!--                        <field name="email_parent" invisible="1" readonly="type == 'opportunity'"/>-->

                        <label for="email_from" class="oe_inline"/>
                        <div class="o_row o_row_readonly">
                            <button name="mail_action_blacklist_remove" class="fa fa-ban text-danger"
                                title="This email is blacklisted for mass mailings. Click to unblacklist."
                                type="object" context="{'default_email': email_from}" groups="base.group_user"
                                invisible="not is_blacklisted"/>
                            <field name="email_from" string="Email" widget="email"/>
                            <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                                title="By saving this change, the customer email will also be updated."
                                invisible="not partner_email_update"/>
                        </div>


                        <label for="street_page_lead" string="Street"/>
                        <div class="o_address_format">
                            <field name="street" id="street_page_lead" placeholder="Street..." class="o_address_street"/>
                            <field name="street2" placeholder="№" class="o_address_street"/>
                            <field name="city" placeholder="City" class="o_address_city"/>
                        </div>

                        <field name="telegram"/>
                        <field name="instagram"/>
                        <field name="whatsapp"/>


                        <label for="date_deadline" class="o_hidden">Expected Closing</label>  <!--Custom-->
                        <div class="o_lead_opportunity_form_inline_fields" style="display: none;">  <!--Custom-->
                            <field name="date_deadline" nolabel="1" class="oe_inline"/>
                            <field name="priority" widget="priority" nolabel="1" class="oe_inline align-top"/>
                        </div>

                        <field name="user_id" invisible="1"
                            context="{'default_sales_team_id': team_id}" widget="many2one_avatar_user"/>

                        <field name="tag_ids" invisible="1" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>


                    <group string="Record on Intro" invisible="type == 'lead' or not partner_id">
                        <field name="program_id"/>

                        <field name="domain_training_id" invisible="1"/>
                        <label for="training_id" invisible="not program_id"/>
                        <div class="o_row" invisible="not program_id">
                            <field name="training_id" domain="domain_training_id" required="program_id"/>
                        </div>

                        <label for="added_trial_training" invisible="not program_id"/>
                        <div class="o_row" invisible="not program_id">
                            <field name="added_trial_training" readonly="1" force_save="1"
                               invisible="not program_id"/>

                            <button name="action_add_child_trial_training" type="object"
                                    string="Add to trainings" class="btn btn-success text-nowrap"
                                    invisible="not training_id or not program_id or added_trial_training"/>
                        </div>


<!--                        <field name="added_trial_training"-->
<!--                               invisible="not training_id or not added_trial_training"/>-->
                    </group>
                    <group string="Other" invisible="type == 'lead'">
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                        <field name="user_id"
                            context="{'default_sales_team_id': team_id}" widget="many2one_avatar_user"/>
                    </group>


                    <group invisible="type == 'opportunity'">
                        <field name="user_id"
                            context="{'default_sales_team_id': team_id}" widget="many2one_avatar_user"/>
                        <field name="team_id" options="{'no_open': True, 'no_create': True}"
                               context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}" groups="base.group_system"/>
                    </group>
                    <group name="lead_priority" invisible="type == 'opportunity'">
                        <field name="priority" widget="priority" groups="base.group_system"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                </group>
                <!--Rewrite global group for swap fields-->

            </xpath>

            <!--Customization in LEAD-->

            <xpath expr="//notebook/page[2]/group/group[2]/field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='extra']/group/group/field[@name='campaign_id']" position="attributes">
                <attribute name="string">utm_campaign</attribute>  <!--Для изменения перевода-->
            </xpath>
            <xpath expr="//page[@name='extra']/group/group/field[@name='medium_id']" position="attributes">
                <attribute name="string">utm_medium</attribute>  <!--Для изменения перевода-->
            </xpath>
            <xpath expr="//page[@name='extra']/group/group/field[@name='source_id']" position="attributes">
                <attribute name="string">utm_source</attribute>  <!--Для изменения перевода-->
            </xpath>
            <xpath expr="//page[@name='extra']/group/group/field[@name='source_id']" position="after">
                <field name="manager_promouter_id" widget="many2one_avatar_user" invisible="medium_id != 11"/>  <!--Промоутер-->

                <field name="utm_term_id"/>
                <field name="utm_content_id"/>

                <field name="medium2_id"/>

                <field name="domain_source2_id" invisible="1"/>
                <field name="source2_id" domain="domain_source2_id"/>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">type == 'lead'</attribute>
            </xpath>

            <!--Customization in LEAD-->

            <!--Customization in OPPORTUNITY-->
            <xpath expr="//button[@name='action_schedule_meeting']" position="before">
                <button class="oe_stat_button" type="object" name="action_open_subscription"
                        icon="fa-refresh" invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Subscriptions
                        </span>
                        <span class="o_stat_value">
                            <field name="count_subscription"/>
                        </span>
                    </div>
                </button>

                <button class="oe_stat_button" type="object" name="action_open_group"
                        icon="fa-folder" invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Groups
                        </span>
                        <span class="o_stat_value">
                            <field name="count_group"/>
                        </span>
                    </div>
                </button>

                <button class="oe_stat_button" type="object" name="action_open_training"
                        icon="fa-rocket" invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Trainings
                        </span>
                        <span class="o_stat_value">
                            <field name="count_training"/>
                        </span>
                    </div>
                </button>

                <button class="oe_stat_button" type="object" name="action_open_attendance"
                        icon="fa-sign-in" invisible="type == 'lead'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Attendance
                        </span>
                        <span class="o_stat_value">
                            <field name="count_attendance"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='lead']/group/group[2]/label[@for='mobile_page_lead']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[2]/div[hasclass('o_row_readonly')]" position="attributes">
                <attribute name="style">display: none;</attribute>
            </xpath>


            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='campaign_id']" position="attributes">
                <attribute name="string">utm_campaign</attribute>  <!--Для изменения перевода-->
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='medium_id']" position="attributes">
                <attribute name="string">utm_medium</attribute>  <!--Для изменения перевода-->
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='source_id']" position="attributes">
                <attribute name="string">utm_source</attribute>  <!--Для изменения перевода-->
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='source_id']" position="after">
                <field name="utm_term_id"/>
                <field name="utm_content_id"/>

                <field name="medium2_id"/>
                <field name="manager_promouter_id" widget="many2one_avatar_user" invisible="medium2_id != 11"/>  <!--Промоутер-->

                <field name="domain_source2_id" invisible="1"/>
                <field name="source2_id" domain="domain_source2_id"/>
            </xpath>

            <xpath expr="//page[@name='lead']/group/group/field[@name='lang_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='lead']/group/group/label" position="attributes">
                <attribute name="class">o_hidden</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group/div" position="attributes">
                <attribute name="class">o_hidden</attribute>
            </xpath>
            <!--Customization in OPPORTUNITY-->

            <xpath expr="//notebook" position="inside">
                <page string="Historical data" name="historical_data">
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="create_date2" readonly="1" force_save="1"/>
                            <field name="date_convert_to_opportunity" readonly="1" force_save="1"/>
                            <field name="need_client" readonly="1" force_save="1"/>
                        </group>
                        <group></group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead2opportunity_partner_inherit" model="ir.ui.view">
        <field name="name">crm.lead2opportunity.partner.form.inherit</field>
        <field name="model">crm.lead2opportunity.partner</field>
        <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_case_form_view_oppor_inherit" model="ir.ui.view">
        <field name="name">crm.case.form.view.oppor.inherit</field>
        <field name="model">crm.lead</field>
