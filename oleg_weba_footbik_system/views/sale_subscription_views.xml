<odoo>

    <record id="sale_subscription_form_inherit" model="ir.ui.view">
        <field name="name">sale.subscription.form.inherit</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//button[@name='manual_invoice']" position="after">
                <button
                        string="Create frozen subscription"
                        class="btn-warning"
                        name="create_frozen_subscription"
                        type="object"
                        invisible="is_frozen"
                    />
            </xpath>
            <xpath expr="//button[@name='create_frozen_subscription']" position="after">
                <button
                        string="Set Active State"
                        class="btn-warning"
                        name="set_action_stage"
                        type="object"
                        invisible="stage_id != 4"
                        groups="oleg_weba_footbik_system.access_change_state_on_active"
                    />
            </xpath>

            <xpath expr="//group" position="after">
                <group>
                    <group string="Program/Group" name="program_training">
                        <field name="program_id"/>

                        <field name="domain_group_id" invisible="1"/>
                        <field name="group_id" domain="domain_group_id" invisible="not program_id"/>
                    </group>
                    <group></group>
                </group>

                <group string="Frozen subscribe" name="frozen_subscribe" invisible="not frozen_subscription_ids">
                    <field name="is_frozen" readonly="1" force_save="1"/>
                    <field name="frozen_subscription_ids">
                        <tree string="All frozen" default_order="create_date desc" create="0">
                            <field name="stage"/>
                            <field name="reason_frozen"/>
                            <field name="start_frozen_date"/>
                            <field name="end_frozen_date"/>
                            <field name="frozen_days"/>
                        </tree>
                    </field>
                </group>
            </xpath>

            <xpath expr="//field[@name='close_reason_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_start']" position="after">
                <field name="date_end"/>
                <field name="close_reason_id" required="date_end"/>
                <field name="trainer_id"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='company_id'][2]" position="after">
                <field name="sum_pay" groups="base.group_system"/>
                <field name="date_pay" groups="base.group_system"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Historical data" name="historical_data">
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="create_date2" readonly="1" force_save="1"/>
                            <field name="date_start2" readonly="1" force_save="1"/>
                        </group>
                        <group></group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_pending_filter_inherit" model="ir.ui.view">
        <field name="name">sale.order.pending.filter.inherit</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.view_sale_order_pending_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='to_renew']" position="before">
                <field name="name"/>
                <field name="partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
