<odoo>
    <data noupdate="1">

        <record id="cron_check_start_end_frozen_subscription" model="ir.cron">
            <field name="name">[OLEG-WEBA] Select frozen subscription and start or end it</field>  <!--Выбор ожидающих заморозки подписок и активируем заморозку-->
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="oleg_weba_footbik_system.model_frozen_subscription"/>
            <field name="priority">5</field>
            <field name="state">code</field>
            <field name="code">model._cron_start_end_frozen_subscription()</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
