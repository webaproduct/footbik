<odoo>
    <data noupdate="0">

        <record id="cron_check_subscription_start" model="ir.cron">
            <field name="name">[OLEG-WEBA] Select records and starting</field>  <!--Выбор ожидающих подписок и активация-->
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="subscription_oca.model_sale_subscription"/>
            <field name="priority">5</field>
            <field name="state">code</field>
            <field name="code">model._cron_check_subscription_start()</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_check_subscription_generate_invoice" model="ir.cron">
            <field name="name">[OLEG-WEBA] Select records and generate invoice</field>  <!--Выбор активных подписок и создание инвойсов если нужная дата-->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="subscription_oca.model_sale_subscription"/>
            <field name="priority">5</field>
            <field name="state">code</field>
            <field name="code">model._cron_check_subscription_generate_invoice()</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="cron_check_subscription_end" model="ir.cron">
            <field name="name">[OLEG-WEBA] Select records and ending</field>  <!--Выбор заканчивающихся подписок и закрытие-->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="model_id" ref="subscription_oca.model_sale_subscription"/>
            <field name="priority">5</field>
            <field name="state">code</field>
            <field name="code">model._cron_check_subscription_end()</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
