<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">


<t t-name="web.CalendarTrainingsCommonRenderer.event">
    <div class="fc-content" style="display: block !important; height: 100%; overflow: hidden;">
        <div style="height: 100%; justify-content: space-between;">
            <div class="o_event_title text-dark"
               style="font-size: 0.75em; line-height: 1; overflow: hidden; text-overflow: ellipsis;"
               t-out="group_name"/>
            <div class="o_event_title text-dark"
               style="font-size: 0.75em; line-height: 1; overflow: hidden; text-overflow: ellipsis;"
               t-out="training_number"/>
            <div class="o_event_title text-dark"
               style="font-size: 0.75em; line-height: 1; overflow: hidden; text-overflow: ellipsis;"
               t-out="max_count_children"/>
            <div class="o_event_title text-dark"
               style="font-size: 0.75em; line-height: 1; overflow: hidden; text-overflow: ellipsis;"
               t-out="trainer_names"/>
        </div>
    </div>
</t>


</templates>
