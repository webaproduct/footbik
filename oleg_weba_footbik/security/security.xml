<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="category_oleg_weba_footbik" model="ir.module.category">
            <field name="name">oleg_weba_footbik</field>
            <field name="description">User access levels for the custom model in module oleg_weba_footbik</field>
            <field name="sequence">1</field>
        </record>

        <record id="admin_access_for_custom_role" model="res.groups">
            <field name="name">Admin access for custom roles</field>
            <field name="category_id" ref="category_oleg_weba_footbik"/>
        </record>

        <record id="rule_class_group_own_company" model="ir.rule">
            <field name="name">Access for own company class.group</field>
            <field name="model_id" ref="model_class_group"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_system')), (4, ref('oleg_weba_footbik.admin_access_for_custom_role'))]"/>
<!--            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>-->
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_class_training_own_company" model="ir.rule">
            <field name="name">Access for own company class.training</field>
            <field name="model_id" ref="model_class_training"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_system')), (4, ref('oleg_weba_footbik.admin_access_for_custom_role'))]"/>
<!--            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>-->
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_class_attendance_own_company" model="ir.rule">
            <field name="name">Access for own company class.attendance</field>
            <field name="model_id" ref="model_class_attendance"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_system')), (4, ref('oleg_weba_footbik.admin_access_for_custom_role'))]"/>
<!--            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>-->
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_class_location_own_company" model="ir.rule">
            <field name="name">Access for own company class.location</field>
            <field name="model_id" ref="model_class_location"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_system')), (4, ref('oleg_weba_footbik.admin_access_for_custom_role'))]"/>
<!--            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>-->
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>